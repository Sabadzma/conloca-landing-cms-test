						"messages": {
							"developers": [
								{
									"first": "Map your React components to typed schemas and MDS blocks in the IDE.",
									"second": " Visual edits respect the structure you define and stay in Git."
								},
								{
									"first": "Editors can only use the fields and blocks you define.",
									"second": " Conloca validates each update before writing it back to the repository."
								},
								{
									"first": "Route content changes through standard Git pull requests.",
									"second": " Review, approve, or revert them just as you would with code."
								}
							],
							"editors": [
								{
									"first": "Developers build and map reusable sections for you.",
									"second": " You use visual editor to build, edit and publish pages without depending on developer."
								},
								{
									"first": "Handle multiple languages by changing only what differs.",
									"second": " Shared content stays automatically in sync for every locale."
								},
								{
									"first": "Create reusable text fragments once and drop them into any page.",
									"second": " Update a shared block and it stays consistent everywhere."
								}
							]
