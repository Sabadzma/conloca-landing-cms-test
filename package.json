    "@fontsource-variable/roboto-mono": "5.2.8",
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@puckeditor/core": "^0.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-web": "^5.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
