---
import SiteLayout from "@/layouts/site-layout.astro"
import { ConlocaHeader } from "@/islands/conloca-header.tsx"
import { ConlocaFooter } from "@/islands/conloca-footer.tsx"
import { ArticlePageSections } from "@/sections/article-page-sections"
import {
  visualEditingArticlePageContent,
  visualEditingArticlePageFooterContent,
  visualEditingArticlePageHeaderContent,
  visualEditingArticlePageMetadata,
} from "@/visual-editing-article-content"
import "@/article-page.css"
---
<SiteLayout metadata={visualEditingArticlePageMetadata}>
  <div class="article-page">
    <ConlocaHeader {...visualEditingArticlePageHeaderContent} client:load />
    <main id="main-content">
      <ArticlePageSections content={visualEditingArticlePageContent} />
    </main>
    <div class="article-footer-wrap">
      <ConlocaFooter {...visualEditingArticlePageFooterContent} />
    </div>
  </div>
</SiteLayout>
