---
import SiteLayout from "@/layouts/site-layout.astro"
import { ConlocaHeader } from "@/islands/conloca-header.tsx"
import { ConlocaFooter } from "@/islands/conloca-footer.tsx"
import { HowItWorksPageSections } from "@/sections/how-it-works-page-sections.tsx"
import {
  howItWorksPageContent,
  howItWorksPageFooterContent,
  howItWorksPageHeaderContent,
  howItWorksPageMetadata,
} from "@/how-it-works-page-content"
import "@/how-it-works-page.css"
---

<SiteLayout metadata={howItWorksPageMetadata}>
  <ConlocaHeader {...howItWorksPageHeaderContent} client:load />
  <main id="main-content">
    <HowItWorksPageSections content={howItWorksPageContent} client:load />
  </main>
  <ConlocaFooter {...howItWorksPageFooterContent} />
</SiteLayout>
