---
import SiteLayout from "@/layouts/site-layout.astro"
import { ConlocaHeader } from "@/islands/conloca-header.tsx"
import { ConlocaFooter } from "@/islands/conloca-footer.tsx"
import { AudienceSections } from "@/sections/audience-sections"
import { CapabilitiesSection } from "@/sections/capabilities-section"
import { PricingSection } from "@/sections/pricing-section"
import { metadata, headerContent, footerContent, audienceContent, capabilitiesContent, pricingContent } from "@/homepage-content"
---
<SiteLayout metadata={metadata}>
  <ConlocaHeader {...headerContent} client:load />
  <main id="main-content">
    <AudienceSections content={audienceContent} client:load />
    <CapabilitiesSection content={capabilitiesContent} client:load />
    <PricingSection content={pricingContent} client:load />
  </main>
  <ConlocaFooter {...footerContent} />
</SiteLayout>
