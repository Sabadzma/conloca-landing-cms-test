---
import SiteLayout from "@/layouts/site-layout.astro"
import { ConlocaHeader } from "@/islands/conloca-header.tsx"
import { ConlocaFooter } from "@/islands/conloca-footer.tsx"
import { PricingPageSections } from "@/sections/pricing-page-sections"
import {
  pricingPageContent,
  pricingPageFooterContent,
  pricingPageHeaderContent,
  pricingPageMetadata,
} from "@/pricing-page-content"
import "@/pricing-page.css"
---
<SiteLayout metadata={pricingPageMetadata}>
  <div class="pricing-page-shell">
    <ConlocaHeader
      {...pricingPageHeaderContent}
      className="pricing-page-header"
      transparent
      client:load
    />
    <main id="main-content">
      <PricingPageSections content={pricingPageContent} client:load />
    </main>
    <ConlocaFooter {...pricingPageFooterContent} />
  </div>
</SiteLayout>
