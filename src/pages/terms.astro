---
import SiteLayout from "@/layouts/site-layout.astro"
import { ConlocaHeader } from "@/islands/conloca-header.tsx"
import { ConlocaFooter } from "@/islands/conloca-footer.tsx"
import { TermsPageSections } from "@/sections/terms-page-sections"
import {
  termsPageContent,
  termsPageFooterContent,
  termsPageHeaderContent,
  termsPageMetadata,
} from "@/terms-content"
import "@/terms-page.css"
---
<SiteLayout metadata={termsPageMetadata}>
  <div class="terms-page">
    <ConlocaHeader {...termsPageHeaderContent} client:load />
    <main id="main-content">
      <TermsPageSections content={termsPageContent} />
    </main>
    <ConlocaFooter {...termsPageFooterContent} />
  </div>
</SiteLayout>
